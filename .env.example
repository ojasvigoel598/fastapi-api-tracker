# ─────────────────────────────────────────────────────────────────────────────
# fastapi-api-tracker — environment variable reference
# Copy to `.env` (or `.env.local`) and fill in real values. NEVER commit `.env`.
# Every variable below is OPTIONAL unless marked Required. With nothing set,
# the app runs the zero-credential in-memory demo.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
# Port for the production server (Docker / `npm run start`). Default: 3000
# PORT=3000

# ── Database (Required for production, OR set DEMO_MODE=true) ───────────────
# MySQL connection string (Drizzle / mysql2). Honours ?ssl-mode=REQUIRED and
# ?connectionLimit= from the URL. TiDB Cloud / Aiven free tier both work.
# Examples:
#   mysql://user:pass@host:3306/dbname?ssl-mode=REQUIRED&connectionLimit=3
# DATABASE_URL=

# One-command local wiring: validates MYSQL_URL, applies migrations, and
# writes .env.local (DATABASE_URL + APP_SECRET) so `npm run dev` serves real
# storage instead of the in-memory demo:
#   MYSQL_URL="mysql://user:pass@host:4000/db?ssl-mode=REQUIRED" npm run db:setup
# MYSQL_URL=

# Run fully in-memory with seeded demo data (no database needed). Never set
# both this and DATABASE_URL.
# DEMO_MODE=true

# ── CI end-to-end storage (Optional — GitHub Actions only) ────────────────
# When set as an Actions secret, the MySQL e2e in CI runs against THIS
# persistent database (same real storage as preview/production) instead of
# the ephemeral mysql:8.4 service container. TiDB Cloud / Aiven free tier.
# MYSQL_E2E_URL=

# ── Session signing (Required for production unless demo) ───────────────────
# Long random value; signs the session cookie and bearer tokens.
#   openssl rand -hex 32
# APP_SECRET=

# ── Owner account (Optional — seeds an admin user) ───────────────────────────
# OWNER_EMAIL=you@example.com
# OWNER_PASSWORD=

# ── Authentication providers (all optional) ──────────────────────────────────
# Clerk (browser + server, both required to activate)
# VITE_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# Supabase (all three required to activate; VITE_* are browser-exposed)
# SUPABASE_URL=
# VITE_SUPABASE_URL=
# SUPABASE_ANON_KEY=
# VITE_SUPABASE_ANON_KEY=
# SUPABASE_JWT_SECRET=

# ── AI insights (Optional — server-only, NEVER exposed to the browser) ───────
# KIMI_OPEN_URL=
# KIMI_API_KEY=

# ── Email alerts for usage-limit breaches (Optional) ─────────────────────────
# RESEND_API_KEY=
# RESEND_FROM=alerts@example.com
# APP_URL=https://your-app.example.com
